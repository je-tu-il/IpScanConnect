<Window x:Class="IpScanConnect.AiAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyse de Sécurité Réseau par IA" Height="560" Width="680" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C14" Foreground="#E2E8F0" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="CollapsibleCard" TargetType="Expander">
            <Setter Property="Background" Value="#131622"/>
            <Setter Property="BorderBrush" Value="#22283C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#131622" BorderBrush="#28324C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="✨ Analyse Gemini" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSummary" Text="Analyse des ports, du débit et des connexions en cours..." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="RiskBadge" Grid.Column="1" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="TxtRiskLevel" Text="⏳ En cours" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                </Border>
            </Grid>
        </Border>

        <!-- Barre de progression pendant l'appel -->
        <ProgressBar x:Name="ProgressLoading" Grid.Row="1" IsIndeterminate="True" Height="4" Margin="0,0,0,10" Background="#131622" Foreground="#3B82F6" BorderThickness="0"/>

        <!-- 4 Sections dépliables -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PanelSections" Visibility="Collapsed">
                <Expander Style="{StaticResource CollapsibleCard}" Header="🔍 Ce que fait l'application" FontWeight="SemiBold" FontSize="12">
                    <TextBlock x:Name="TxtWhatItDoes" TextWrapping="Wrap" FontSize="12" Foreground="#CBD5E1" Margin="4,6,4,4" FontWeight="Normal"/>
                </Expander>

                <Expander Style="{StaticResource CollapsibleCard}" Header="💡 Utilité" FontWeight="SemiBold" FontSize="12">
                    <TextBlock x:Name="TxtUtility" TextWrapping="Wrap" FontSize="12" Foreground="#CBD5E1" Margin="4,6,4,4" FontWeight="Normal"/>
                </Expander>

                <Expander Style="{StaticResource CollapsibleCard}" Header="⚠️ Risques &amp; Confidentialité" FontWeight="SemiBold" FontSize="12">
                    <TextBlock x:Name="TxtRisks" TextWrapping="Wrap" FontSize="12" Foreground="#FCA5A5" Margin="4,6,4,4" FontWeight="Normal"/>
                </Expander>

                <Expander Style="{StaticResource CollapsibleCard}" Header="✂️ Impact si on coupe Internet" FontWeight="SemiBold" FontSize="12">
                    <TextBlock x:Name="TxtCutImpact" TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" Margin="4,6,4,4" FontWeight="Normal"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Pied de fenêtre -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Fermer" Width="90" Height="30" Background="#1E2337" Foreground="#E2E8F0" BorderBrush="#2F3854" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
