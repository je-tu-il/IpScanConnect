<Window x:Class="IpScanConnect.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saisie" Height="190" Width="420"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Background="#161925" Foreground="#E0E6ED"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtPrompt" Grid.Row="0" Text="Entrez l'adresse IP à bloquer :"
                   FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,10"/>

        <TextBox x:Name="TxtInput" Grid.Row="1" Height="32" Padding="8,4" FontSize="14"
                 Background="#0F111A" Foreground="#FFFFFF" BorderBrush="#3B82F6"
                 VerticalContentAlignment="Center" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="BtnCancel" Content="Annuler" Width="80" Height="32" Margin="0,0,8,0"
                    Background="#1E2337" Foreground="#94A3B8" Click="BtnCancel_Click"/>
            <Button x:Name="BtnOk" Content="Valider" Width="80" Height="32"
                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
