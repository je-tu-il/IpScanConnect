<Window x:Class="IpScanConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IpScanConnect"
        Height="700" Width="1160" MinHeight="500" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#19191B" Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Couleurs du thème sombre -->
        <SolidColorBrush x:Key="BgDark" Color="#19191B"/>
        <SolidColorBrush x:Key="CardBg" Color="#242426"/>
        <SolidColorBrush x:Key="CardHeaderBg" Color="#2B2B2E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#39393D"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#146BC1"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="TextMuted" Color="#AEAEB2"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>

        <!-- Style Boutons Standards -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303033"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#46464B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404045"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#9AC9FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Bouton Bloquer (Rouge) -->
        <Style x:Key="BtnBlockRed" TargetType="Button">
            <Setter Property="Background" Value="#7D3035"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="BorderBrush" Value="#EF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Bouton Gemini IA -->
        <Style x:Key="BtnGemini" TargetType="Button">
            <Setter Property="Background" Value="#303034"/>
            <Setter Property="Foreground" Value="#E5E5EA"/>
            <Setter Property="BorderBrush" Value="#55555A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#312E81"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#818CF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Bouton Secondaire Gris -->
        <Style x:Key="BtnCutGray" TargetType="Button">
            <Setter Property="Background" Value="#303033"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#2F3854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style ListBoxItem sans rectangle de sélection bleu -->
        <Style x:Key="CleanListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Expander -->
        <Style x:Key="CollapsibleAiCard" TargetType="Expander">
            <Setter Property="Background" Value="#242426"/>
            <Setter Property="BorderBrush" Value="#39393D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>

        <!-- Style DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#242426"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="RowBackground" Value="#242426"/>
            <Setter Property="AlternatingRowBackground" Value="#252528"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#303033"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#39393D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2B2B2E"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#39393D"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Onglets -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AEAEB2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2B2B2E"/>
                                <Setter Property="Foreground" Value="#80BCFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. EN-TÊTE SIMPLIFIÉ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="IpScanConnect" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- KPIs compacts inspirés de Sniffnet -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="3,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Apps : " FontSize="11" Foreground="#AEAEB2"/>
                        <TextBlock x:Name="TxtTotalApps" Text="0" FontSize="11" FontWeight="Bold" Foreground="#80BCFF"/>
                    </StackPanel>
                </Border>
                <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="3,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Internet : " FontSize="11" Foreground="#AEAEB2"/>
                        <TextBlock x:Name="TxtInternetCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                        <TextBlock Text="Local : " FontSize="11" Foreground="#AEAEB2"/>
                        <TextBlock x:Name="TxtLocalCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
                <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="3,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Débit : " FontSize="11" Foreground="#AEAEB2"/>
                        <TextBlock x:Name="TxtTotalBandwidth" Text="↑ 0 B/s ↓ 0 B/s" FontSize="11" FontWeight="Bold" Foreground="#D1D1D6"/>
                    </StackPanel>
                </Border>
                <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="3,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bloqués : " FontSize="11" Foreground="#AEAEB2"/>
                        <TextBlock x:Name="TxtBlockedSummary" Text="0" FontSize="11" FontWeight="Bold" Foreground="#F87171"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnWatchStatusPill" Content="Surveillance : ON" Margin="4,0,0,0" Click="BtnWatchStatusPill_Click"
                        ToolTip="Surveille les nouvelles applications inconnues et garde IpScanConnect actif dans les icônes cachées"/>
            </StackPanel>
        </Grid>

        <!-- 2. BARRE DE RECHERCHE UNIFIÉE (S'APPLIQUE À L'ONGLET ACTIF) -->
        <Border Grid.Row="1" Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="TxtSearch" Height="28" Padding="8,3,26,3" FontSize="12"
                             Background="#19191B" Foreground="#FFFFFF" BorderBrush="#414145"
                             VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock x:Name="TxtSearchHint" Text="Rechercher une application, une IP ou un port…"
                               FontSize="11" Foreground="#9B9BA1" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,26,0"/>
                    <Button x:Name="BtnClearSearch" Content="✕" Width="22" Height="22" Padding="0"
                            HorizontalAlignment="Right" Margin="0,0,4,0" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Click="BtnClearSearch_Click"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCollapseAll" Content="Tout replier" Margin="2,0" Click="BtnCollapseAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. ONGLETS PRINCIPAUX -->
        <TabControl Grid.Row="2" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

            <!-- ONGLET 1 : CONNEXIONS RÉSEAU -->
            <TabItem Header="Connexions">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BARRE INTERNE : MODES D'AFFICHAGE + FILTRE INTERNET/LOCAL + TRI -->
                    <Border Grid.Row="0" Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                        <Expander Header="Affichage et filtres" Foreground="#F2F2F5" IsExpanded="False"><Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Modes d'affichage (Par App / Cases Windows / Par type) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnGroupApps" Content="Liste" Margin="0,0,4,0" Background="#146BC1" Click="BtnGroupApps_Click"
                                        ToolTip="Affiche chaque application comme une carte dépliable"/>
                                <Button x:Name="BtnGroupTiles" Content="Grille" Margin="0,0,4,0" Click="BtnGroupTiles_Click"
                                        ToolTip="Affiche toutes les applications côte-à-côte façon tuiles Sniffnet / Windows"/>
                                <Button x:Name="BtnGroupCategories" Content="Par type" Margin="0,0,10,0" Click="BtnGroupCategories_Click"
                                        ToolTip="Regroupe par Utilisateur, Système &amp; Windows, Services en Écoute et Bloqués"/>
                            </StackPanel>

                            <!-- Filtre Internet vs LAN vs Ports Locaux -->
                            <Border Grid.Column="1" BorderBrush="#39393D" BorderThickness="1,0,0,0" Padding="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnScopeAll" Content="Tout" Margin="0,0,4,0" Background="#146BC1" Click="BtnScopeFilter_Click" Tag="ALL"/>
                                    <Button x:Name="BtnScopeInternet" Content="Internet" Margin="0,0,4,0" Click="BtnScopeFilter_Click" Tag="INTERNET"
                                            ToolTip="Uniquement les vraies connexions vers Internet (IP publiques)"/>
                                    <Button x:Name="BtnScopeLan" Content="LAN" Margin="0,0,4,0" Click="BtnScopeFilter_Click" Tag="LAN"
                                            ToolTip="Réseau local (192.168.x.x, 10.x.x.x...)"/>
                                    <Button x:Name="BtnScopeLocal" Content="Ports locaux" Margin="0,0,4,0" Click="BtnScopeFilter_Click" Tag="LOCAL"
                                            ToolTip="Ports locaux en écoute et loopback (127.0.0.1 / ::1)"/>
                                </StackPanel>
                            </Border>

                            <!-- Tri (Nom, Données envoyées, Reçues, Total, Ports, Flux + Sens) -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Trier :" FontSize="11" Foreground="#AEAEB2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbSortBy" Width="160" Height="26" FontSize="11" SelectedIndex="0"
                                          SelectionChanged="CmbSortBy_SelectionChanged"
                                          Foreground="#0F172A">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="Flux (Connexions)" Tag="COUNT"/>
                                    <ComboBoxItem Content="Nom (Alphabétique)" Tag="NAME"/>
                                    <ComboBoxItem Content="Données envoyées" Tag="SENT"/>
                                    <ComboBoxItem Content="Données reçues" Tag="RECV"/>
                                    <ComboBoxItem Content="Trafic total" Tag="TOTAL_BYTES"/>
                                    <ComboBoxItem Content="Ports utilisés" Tag="PORTS"/>
                                </ComboBox>
                                <Button x:Name="BtnSortDir" Content="Décroissant" Margin="6,0,0,0" Click="BtnSortDir_Click"
                                        ToolTip="Inverser l'ordre de tri (Croissant / Décroissant)"/>
                            </StackPanel>
                        </Grid></Expander>
                    </Border>

                    <!-- VUE A : LISTE VIRTUALISÉE (CARTES DÉPLIABLES SANS LAG) -->
                    <ListBox x:Name="ListProcessGroups" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CleanListItemStyle}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- EN-TÊTE DE CARTE (AVEC CLIC DROIT -> OUVRIR LE DOSSIER) -->
                                        <Border Grid.Row="0" Background="#2B2B2E" CornerRadius="8,8,0,0" Padding="10,8" Cursor="Hand"
                                                MouseLeftButtonUp="GroupHeader_MouseLeftButtonUp" Tag="{Binding}"
                                                ContextMenuOpening="GroupCard_ContextMenuOpening">
                                            <Border.ContextMenu>
                                                <ContextMenu/>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding ChevronIcon}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{Binding ChevronColor}" VerticalAlignment="Center" Margin="0,0,8,0" Width="14"/>

                                                <!-- Icône réelle de l'app ou Emoji -->
                                                <Border Grid.Column="1" Background="#1E2438" Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{Binding AppIcon}" Width="22" Height="22" Visibility="{Binding HasAppIcon, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding IconEmoji}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasNoAppIcon, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Infos principales -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,8,0"/>
                                                        <Border Background="#1E293B" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding ScopeSummary}" FontSize="10" Foreground="#34D399" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SubtitleDisplay}" FontSize="10" Foreground="#9B9BA1" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Débit mesuré -->
                                                <Border Grid.Column="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ThroughputSummary}" FontSize="10" FontWeight="SemiBold" Foreground="#D1D1D6"/>
                                                </Border>

                                                <!-- Badge Flux -->
                                                <Border Grid.Column="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountBadge}" FontSize="10" FontWeight="Bold" Foreground="#80BCFF"/>
                                                </Border>

                                                <!-- Bouton Gemini IA -->
                                                <Button Grid.Column="5" Content="IA" Style="{StaticResource BtnGemini}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Click="BtnAnalyzeApp_Click" Tag="{Binding}"
                                                        ToolTip="Analyser les ports, débits et risques de cette application avec Gemini IA"/>

                                                <!-- Bouton Bloquer / Débloquer -->
                                                <Button Grid.Column="6" Content="{Binding BlockButtonText}" Style="{StaticResource BtnBlockRed}" VerticalAlignment="Center"
                                                        Click="BtnBlockAppFromGroup_Click" Tag="{Binding}"
                                                        Visibility="{Binding CanBlockApp, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Bloquer ou débloquer immédiatement tout accès réseau pour cette application"/>
                                            </Grid>
                                        </Border>

                                        <!-- LISTE VIRTUALISÉE DES CONNEXIONS (VIDE QUAND REPLIÉE = ZÉRO LAG) -->
                                        <Border Grid.Row="1" Background="#19191B" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0" BorderBrush="#303033"
                                                Padding="8,6" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ListBox ItemsSource="{Binding VisibleConnections}"
                                                     MaxHeight="360"
                                                     Background="Transparent" BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource CleanListItemStyle}"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Pixel"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.CanContentScroll="True">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#242426" BorderBrush="#1C2133" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,0,0,4"
                                                                Tag="{Binding}" ContextMenuOpening="ConnectionRow_ContextMenuOpening">
                                                            <Border.ContextMenu>
                                                                <ContextMenu/>
                                                            </Border.ContextMenu>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="95"/>
                                                                    <ColumnDefinition Width="260"/>
                                                                    <ColumnDefinition Width="200"/>
                                                                    <ColumnDefinition Width="155"/>
                                                                    <ColumnDefinition Width="52"/>
                                                                    <ColumnDefinition Width="125"/>
                                                                    <ColumnDefinition Width="95"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                <!-- Scope : Internet vs LAN vs Port local -->
                                                                <Border Grid.Column="1" Background="#303033" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding ScopeBadge}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding ScopeColor}"/>
                                                                </Border>

                                                                <!-- Destination -->
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding DestinationTitle}" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding DestinationSubtitle}" FontSize="9.5" Foreground="#80BCFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                                </StackPanel>

                                                                <!-- Application & Service propriétaire (clé pour Services en Écoute & Par type) -->
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <TextBlock Text="Application / Service :" FontSize="8.5" Foreground="#9B9BA1"/>
                                                                    <TextBlock Text="{Binding OwningAppDisplay}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Local Endpoint -->
                                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                    <TextBlock Text="Local :" FontSize="8.5" Foreground="#9B9BA1"/>
                                                                    <TextBlock Text="{Binding LocalDisplay}" FontSize="10.5" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Protocole -->
                                                                <Border Grid.Column="5" Background="#1E293B" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProtocolDisplay}" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                                                                </Border>

                                                                <!-- Débit -->
                                                                <TextBlock Grid.Column="6" Text="{Binding ThroughputDisplay}" FontSize="10" Foreground="#D1D1D6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                <!-- Statut -->
                                                                <TextBlock Grid.Column="7" Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                                                <!-- Actions Rapides -->
                                                                <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="IP" Style="{StaticResource BtnBlockRed}" Margin="0,0,4,0" Padding="6,3"
                                                                            Click="BtnBlockIpFromRow_Click" Tag="{Binding}"
                                                                            ToolTip="Bloquer cette adresse IP"/>
                                                                    <Button Content="❌" Style="{StaticResource BtnCutGray}" Padding="6,3"
                                                                            Click="BtnCloseTcpFromRow_Click" Tag="{Binding}"
                                                                            ToolTip="Couper la connexion TCP (Reset)"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- VUE B : CASES CÔTE-À-CÔTE INSPIRÉE DE SNIFFNET -->
                    <ScrollViewer x:Name="ScrollTileMode" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <ItemsControl x:Name="ListTilesGroups">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Margin="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242426" BorderBrush="#262E47" BorderThickness="1" CornerRadius="9" Margin="5" Width="292" MinHeight="168" Padding="11"
                                            Tag="{Binding}" ContextMenuOpening="GroupCard_ContextMenuOpening">
                                        <Border.ContextMenu>
                                            <ContextMenu/>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- En-tête tuile -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#1E2438" Width="34" Height="34" CornerRadius="7" Margin="0,0,9,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{Binding AppIcon}" Width="24" Height="24" Visibility="{Binding HasAppIcon, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding IconEmoji}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasNoAppIcon, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#9B9BA1" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountBadge}" FontSize="10" FontWeight="Bold" Foreground="#80BCFF"/>
                                                </Border>
                                            </Grid>

                                            <!-- Badges Internet / Local & Débit -->
                                            <Border Grid.Row="1" Background="#202022" BorderBrush="#303033" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,8,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ScopeSummary}" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                                    <TextBlock Text="{Binding ThroughputSummary}" FontSize="10" Foreground="#D1D1D6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Ports & Hôtes -->
                                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding PortsPreview}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SubtitleDisplay}" FontSize="9" Foreground="#9B9BA1" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Actions pied de tuile -->
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="Flux" Style="{StaticResource BtnCutGray}" Margin="0,0,4,0" Click="BtnInspectTile_Click" Tag="{Binding}"
                                                        ToolTip="Déplier les connexions de cette application"/>
                                                <Button Grid.Column="1" Content="IA" Style="{StaticResource BtnGemini}" Margin="0,0,4,0" Click="BtnAnalyzeApp_Click" Tag="{Binding}"
                                                        ToolTip="Analyser cette application avec Gemini IA"/>
                                                <Button Grid.Column="2" Content="📂" Style="{StaticResource BtnCutGray}" HorizontalAlignment="Left" Padding="7,4" Click="BtnOpenGroupFolder_Click" Tag="{Binding}"
                                                        ToolTip="Ouvrir le dossier de l'application"/>
                                                <Button Grid.Column="3" Content="{Binding BlockButtonText}" Style="{StaticResource BtnBlockRed}" Click="BtnBlockAppFromGroup_Click" Tag="{Binding}"
                                                        Visibility="{Binding CanBlockApp, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Bloquer ou débloquer cette application"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ONGLET 2 : RÈGLES DE BLOCAGE & TENTATIVES BLOQUÉES -->
            <TabItem Header="Blocages">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="+ Bloquer une IP" Margin="0,0,8,0" Background="#DC2626" Click="BtnManualBlockIp_Click"/>
                                <Button Content="+ Bloquer une Application (.exe)" Margin="0,0,8,0" Background="#46464B" Click="BtnManualBlockApp_Click"/>
                                <Button x:Name="BtnManualBlockFolder" Content="Bloquer un Dossier (Sandbox)" Margin="0,0,8,0" Background="#46464B" Click="BtnManualBlockFolder_Click"
                                        ToolTip="Bloque tous les .exe du dossier et surveille tout nouveau .exe déposé dedans"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Débloquer la sélection" Click="BtnUnblockSelected_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Règles actives -->
                    <DataGrid x:Name="GridRules" Grid.Row="1" Margin="0,0,0,8" ContextMenuOpening="GridRules_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu/>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding RuleType}" Width="140" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Cible (IP, .exe ou Dossier Sandbox)" Binding="{Binding Target}" Width="*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Tentatives bloquées" Binding="{Binding BlockedHitsDisplay}" Width="140" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="190"/>
                            <DataGridTextColumn Header="Nom de la règle" Binding="{Binding RuleName}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- En-tête Tentatives Bloquées -->
                    <Border Grid.Row="2" Background="#2B2B2E" BorderBrush="#39393D" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tentatives de connexion bloquées" FontSize="12" FontWeight="Bold" Foreground="#F87171"/>
                                <TextBlock x:Name="TxtAttemptsInfo" Text=" (Sockets bloqués, Sandbox &amp; Audit WFP)" FontSize="11" Foreground="#AEAEB2" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="Effacer la liste" HorizontalAlignment="Right" Padding="8,3" Click="BtnClearAttempts_Click"/>
                        </Grid>
                    </Border>

                    <!-- Liste des tentatives bloquées -->
                    <DataGrid x:Name="GridBlockedAttempts" Grid.Row="3" ContextMenuOpening="GridAttempts_ContextMenuOpening">
                        <DataGrid.ContextMenu>
                            <ContextMenu/>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Heure" Binding="{Binding TimeDisplay}" Width="75"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="95"/>
                            <DataGridTextColumn Header="Application" Binding="{Binding AppDisplay}" Width="180" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="55"/>
                            <DataGridTextColumn Header="Cible bloquée" Binding="{Binding TargetDisplay}" Width="170" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Règle déclenchée" Binding="{Binding MatchedRule}" Width="180"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ONGLET 3 : ANALYSE IA (OXION AI / GEMINI) -->
            <TabItem Header="Analyse IA">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <!-- Configuration IA (Oxion AI / Gemini / OpenAI) -->
                    <Border Grid.Row="0" Background="#242426" BorderBrush="#46464B" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ligne 1 : Fournisseur, Modèle et URL de base -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="195"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Fournisseur IA :" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <ComboBox x:Name="CmbAiProvider" Grid.Column="1" Height="28" Margin="0,0,12,0" SelectedIndex="0" FontSize="11" Foreground="#0F172A" SelectionChanged="CmbAiProvider_SelectionChanged">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="Oxion AI (Recommandé)" Tag="OxionAi"/>
                                    <ComboBoxItem Content="Google Gemini" Tag="Gemini"/>
                                    <ComboBoxItem Content="OpenAI / Compatible" Tag="OpenAI"/>
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="Modèle :" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <ComboBox x:Name="CmbGeminiModel" Grid.Column="3" Height="28" Margin="0,0,12,0" IsEditable="True" SelectedIndex="0" FontSize="11" Foreground="#0F172A">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                    <ComboBoxItem Content="gpt-4o-mini"/>
                                    <ComboBoxItem Content="gpt-4o"/>
                                    <ComboBoxItem Content="claude-3-5-sonnet"/>
                                    <ComboBoxItem Content="claude-3-5-haiku"/>
                                    <ComboBoxItem Content="gemini-2.0-flash"/>
                                    <ComboBoxItem Content="deepseek-chat"/>
                                </ComboBox>

                                <TextBlock x:Name="LblAiBaseUrl" Grid.Column="4" Text="Base URL :" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <TextBox x:Name="TxtAiBaseUrl" Grid.Column="5" Height="28" Padding="6,3" Background="#19191B" Foreground="#94A3B8" BorderBrush="#414145" VerticalContentAlignment="Center" Text="https://oxionai.com/v1" ToolTip="Point d'entrée de l'API"/>
                            </Grid>

                            <!-- Ligne 2 : Clé API, Sauvegarde et Analyse Globale -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="LblAiApiKey" Grid.Column="0" Text="Clé API Oxion AI :" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <Grid Grid.Column="1" Margin="0,0,6,0">
                                    <PasswordBox x:Name="PwdGeminiKey" Height="28" Padding="6,3" Background="#19191B" Foreground="#FFFFFF" BorderBrush="#414145" VerticalContentAlignment="Center" ToolTip="Entrez votre clé API Oxion AI (ex: cc_... depuis oxionai.com)"/>
                                    <TextBox x:Name="TxtGeminiKeyVisible" Height="28" Padding="6,3" Background="#19191B" Foreground="#FFFFFF" BorderBrush="#414145" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                                </Grid>

                                <Button x:Name="BtnToggleKeyVis" Grid.Column="2" Content="👁️" Width="32" Height="28" Margin="0,0,8,0" Click="BtnToggleKeyVis_Click"
                                        ToolTip="Afficher / masquer la clé API"/>

                                <Button x:Name="BtnTestAiKey" Grid.Column="3" Content="Tester la clé" Click="BtnTestAiKey_Click" Margin="0,0,8,0" Padding="10,4" ToolTip="Vérifier la validité de la clé auprès du fournisseur IA"/>

                                <Button x:Name="BtnSaveGeminiKey" Grid.Column="4" Content="Enregistrer" Click="BtnSaveGeminiKey_Click" Margin="0,0,10,0" Padding="12,4"/>

                                <Button x:Name="BtnAnalyzePcGlobal" Grid.Column="5" Content="Analyser le trafic du PC" Style="{StaticResource BtnGemini}" Padding="16,6" Click="BtnAnalyzePcGlobal_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Statut et Résumé -->
                    <Border Grid.Row="1" Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TxtGlobalAiTitle" Text="Analyse de sécurité réseau par IA (Oxion AI / Gemini)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtGlobalAiSummary" Text="Configurez votre clé API (Oxion AI ou Gemini) puis cliquez sur 'Analyser le trafic du PC' ou sur le bouton '✨ IA' d'une application." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border x:Name="GlobalRiskBadge" Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="TxtGlobalAiRisk" Text="Prêt" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="ProgressGlobalAi" Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="Collapsed" Background="#19191B" Foreground="#55555A" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- 4 Sections dépliables -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Expander Style="{StaticResource CollapsibleAiCard}" Header="Ce que fait le trafic / l'application" FontWeight="SemiBold" FontSize="12">
                                <TextBlock x:Name="TxtGlobalWhatItDoes" Text="En attente d'analyse." TextWrapping="Wrap" FontSize="12" Foreground="#CBD5E1" Margin="4,6,4,4" FontWeight="Normal"/>
                            </Expander>
                            <Expander Style="{StaticResource CollapsibleAiCard}" Header="Utilité" FontWeight="SemiBold" FontSize="12">
                                <TextBlock x:Name="TxtGlobalUtility" Text="En attente d'analyse." TextWrapping="Wrap" FontSize="12" Foreground="#CBD5E1" Margin="4,6,4,4" FontWeight="Normal"/>
                            </Expander>
                            <Expander Style="{StaticResource CollapsibleAiCard}" Header="Risques &amp; Confidentialité" FontWeight="SemiBold" FontSize="12">
                                <TextBlock x:Name="TxtGlobalRisks" Text="En attente d'analyse." TextWrapping="Wrap" FontSize="12" Foreground="#FCA5A5" Margin="4,6,4,4" FontWeight="Normal"/>
                            </Expander>
                            <Expander Style="{StaticResource CollapsibleAiCard}" Header="Impact si on coupe Internet" FontWeight="SemiBold" FontSize="12">
                                <TextBlock x:Name="TxtGlobalCutImpact" Text="En attente d'analyse." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" Margin="4,6,4,4" FontWeight="Normal"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Historique des analyses IA -->
                    <Border Grid.Row="3" Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Historique des analyses IA (cliquez pour relire)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <ListBox x:Name="ListAiHistory" Grid.Row="1" Background="#19191B" Foreground="#CBD5E1" BorderBrush="#39393D"
                                     DisplayMemberPath="HeaderDisplay" SelectionChanged="ListAiHistory_SelectionChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ONGLET 4 : OPTIONS, REDIRECTIONS & JOURNAL DE SÉCURITÉ -->
            <TabItem Header="Options &amp; Alertes">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Section 1 : Mode Surveillance & Systray -->
                        <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Mode Surveillance &amp; Icônes cachées (Systray)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkWatchMode" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"
                                          Content="Alerter lorsqu'une nouvelle application inconnue ouvre une connexion réseau (hors réglages/local)"
                                          Checked="WatchOption_Changed" Unchecked="WatchOption_Changed"/>
                                <CheckBox x:Name="ChkTrustInstalled" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"
                                          Content="Faire confiance par défaut aux applications déjà installées (Program Files &amp; Windows)"
                                          Checked="WatchOption_Changed" Unchecked="WatchOption_Changed"/>
                                <CheckBox x:Name="ChkOnlyAlertSuspicious" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"
                                          Content="Mode alertes ciblées : notifier uniquement en cas d'application douteuse (dossier temporaire, port anormal)"
                                          Checked="WatchOption_Changed" Unchecked="WatchOption_Changed"/>
                                <CheckBox x:Name="ChkMinimizeTray" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,6"
                                          Content="Fermer la fenêtre réduit IpScanConnect dans les icônes cachées (Systray) pour continuer la surveillance"
                                          Checked="WatchOption_Changed" Unchecked="WatchOption_Changed"/>
                                <CheckBox x:Name="ChkWfpAudit" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,10"
                                          Content="Activer l'audit Windows WFP (journalise les paquets bloqués par le pare-feu dans 'Blocages')"
                                          Checked="ChkWfpAudit_Changed" Unchecked="ChkWfpAudit_Changed"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Marquer les apps actuelles comme connues" Click="BtnBaselineKnown_Click" Margin="0,0,8,0"/>
                                    <Button Content="Réinitialiser les apps connues" Click="BtnClearKnown_Click" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtKnownAppsCount" Text="0 app(s) connue(s)" FontSize="11" Foreground="#AEAEB2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 2 : Redirections de Sites / Hôtes -->
                        <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Redirection de sites / hôtes (fichier hosts Windows)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Redirige les requêtes vers un domaine (ex: télémétrie, site distrayant) vers une autre IP (par défaut 127.0.0.1 ou un serveur local)."
                                           FontSize="11" Foreground="#AEAEB2" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtRedirectDomain" Grid.Column="0" Height="28" Padding="8,3" Background="#19191B" Foreground="#FFFFFF" BorderBrush="#414145"
                                             VerticalContentAlignment="Center" ToolTip="Domaine à rediriger (ex: ads.exemple.com)"/>
                                    <TextBlock Grid.Column="1" Text="  →  " Foreground="#AEAEB2" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <TextBox x:Name="TxtRedirectTarget" Grid.Column="2" Height="28" Padding="8,3" Text="127.0.0.1" Background="#19191B" Foreground="#FFFFFF" BorderBrush="#414145"
                                             VerticalContentAlignment="Center" ToolTip="IP ou hôte cible (ex: 127.0.0.1)"/>
                                    <Button Grid.Column="3" Content="+ Ajouter redirection" Margin="8,0,0,0" Background="#146BC1" Click="BtnAddRedirect_Click"/>
                                </Grid>

                                <DataGrid x:Name="GridRedirects" Height="150" Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="90" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Domaine source" Binding="{Binding SourceDomain}" Width="*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Redirigé vers (IP)" Binding="{Binding TargetAddress}" Width="180"/>
                                        <DataGridTemplateColumn Header="Actions" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Activer/Pause" Padding="6,2" Margin="0,0,4,0" Click="BtnToggleRedirect_Click" Tag="{Binding}"/>
                                                        <Button Content="🗑️" Padding="6,2" Background="#7D3035" Click="BtnDeleteRedirect_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Section 3 : Garanties techniques honnêtes -->
                        <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Garanties réelles &amp; limites du blocage WFP" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8"
                                           Text="Les règles de blocage IP / Application / Dossier Sandbox sont inscrites dans le Pare-feu Windows (WFP/BFE) : elles restent actives même si l'app est fermée, supprimée ou si le PC redémarre.&#x0a;• Le mode Sandbox dossier bloque les .exe existants et surveille en temps réel tout nouvel .exe créé dedans tant qu'IpScanConnect tourne (icônes cachées).&#x0a;• Limites connues sans pilote noyau signé WHQL : un exécutable copié hors du dossier sandbox, une règle Windows 'Autoriser' prioritaire, un VPN/proxy ou un navigateur utilisant DNS-over-HTTPS (DoH) pour le fichier hosts peuvent contourner un filtre par chemin ou domaine."/>
                            </StackPanel>
                        </Border>

                        <!-- Section 3bis : Préférence de redirection & Mises à jour -->
                        <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Mises à jour logicielles &amp; Préférences de redirection" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkPreferHostsRedirect" Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,10"
                                          Content="Préférer la redirection 127.0.0.1 (Hosts Sinkhole) au blocage pare-feu pur lorsque possible"
                                          Checked="WatchOption_Changed" Unchecked="WatchOption_Changed"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCheckUpdates" Content="Vérifier les mises à jour" Padding="12,5" Click="BtnCheckUpdates_Click" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtUpdateStatus" Text="Version actuelle : v1.0.0" FontSize="12" Foreground="#AEAEB2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 4 : Journal de Sécurité (Alertes & Actions) -->
                        <Border Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Journal de Sécurité (Alertes surveillance, Sandbox &amp; Blocages)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Effacer" Margin="0,0,6,0" Click="BtnClearLogs_Click"/>
                                        <Button Content="Exporter (.txt / .csv)" Click="BtnExportLogs_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="GridLogs" Height="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Heure" Binding="{Binding TimeDisplay}" Width="80"/>
                                        <DataGridTextColumn Header="Événement" Binding="{Binding EventType}" Width="155" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Application" Binding="{Binding ProcessName}" Width="160"/>
                                        <DataGridTextColumn Header="Cible" Binding="{Binding Target}" Width="190" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Détails" Binding="{Binding Details}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 4. PIED DE PAGE -->
        <Border Grid.Row="3" Background="#242426" BorderBrush="#39393D" BorderThickness="1" CornerRadius="7" Margin="0,6,0,0" Padding="8,4">
            <Grid>
                <TextBlock x:Name="TxtStatusBar" Text="Prêt. Surveillance réseau active." Foreground="#AEAEB2" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtLastUpdate" Text="Dernière mise à jour : --:--:--" Foreground="#9B9BA1" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- OVERLAYS INTERACTION UI -->

        <!-- In-App Confirmation Modal Overlay -->
        <Grid x:Name="GridConfirmOverlay" Visibility="Collapsed" Background="#B0000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="9999">
            <Border Background="#242426" BorderBrush="#46464B" BorderThickness="1" CornerRadius="10" 
                    Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="TxtConfirmTitle" Text="Confirmation" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtConfirmMessage" Text="Voulez-vous vraiment effectuer cette action ?" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnConfirmCancel" Content="Annuler" Padding="14,6" Margin="0,0,10,0" Click="BtnConfirmCancel_Click"/>
                        <Button x:Name="BtnConfirmOk" Content="Confirmer" Style="{StaticResource BtnBlockRed}" Padding="16,6" Click="BtnConfirmOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- In-App Tile Flux Inspection Overlay -->
        <Grid x:Name="GridTileFluxOverlay" Visibility="Collapsed" Background="#B0000000" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="9998">
            <Border Background="#242426" BorderBrush="#46464B" BorderThickness="1" CornerRadius="10" 
                    Width="820" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtTileFluxTitle" Text="Flux réseau de l'application" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Button Content="✕ Fermer" HorizontalAlignment="Right" Padding="8,4" Click="BtnCloseTileFlux_Click"/>
                    </Grid>
                    <DataGrid x:Name="GridTileFluxConnections" Grid.Row="1" MaxHeight="380" AutoGenerateColumns="False" IsReadOnly="True" Background="#19191B">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proto" Binding="{Binding ProtocolDisplay}" Width="60"/>
                            <DataGridTextColumn Header="Adresse Locale" Binding="{Binding LocalDisplay}" Width="160"/>
                            <DataGridTextColumn Header="Adresse Distante" Binding="{Binding RemoteDisplay}" Width="180"/>
                            <DataGridTextColumn Header="Hôte résolu" Binding="{Binding RemoteHost}" Width="160"/>
                            <DataGridTextColumn Header="État" Binding="{Binding State}" Width="95"/>
                            <DataGridTextColumn Header="Portée" Binding="{Binding ScopeBadge}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Fermer" Padding="14,6" Click="BtnCloseTileFlux_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
