<Window x:Class="IpScanConnect.Installer.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant d'Installation - IpScanConnect"
        Height="460" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C14" Foreground="#E2E8F0"
        FontFamily="Segoe UI" ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1F30"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2A334E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262E48"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BANNIÈRE D'EN-TÊTE -->
        <Border Grid.Row="0" Background="#131622" BorderBrush="#22283C" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#1E293B" Width="48" Height="48" CornerRadius="10" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Installation de IpScanConnect v1.0" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Moniteur de flux réseau &amp; Filtrage haute performance pour Windows" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CORPS DU PROGRAMME D'INSTALLATION -->
        <Border Grid.Row="1" Background="#131622" BorderBrush="#22283C" BorderThickness="1" CornerRadius="10" Padding="18">
            <Grid>
                <!-- ÉCRAN 1: CONFIGURATION -->
                <StackPanel x:Name="PanelSetup" VerticalAlignment="Center">
                    <TextBlock Text="Dossier de destination :" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallPath" Height="32" Padding="8,5" FontSize="12"
                                 Background="#0A0C14" Foreground="#FFFFFF" BorderBrush="#2D3550"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="Parcourir..." Margin="8,0,0,0" Width="85"
                                Click="BtnBrowse_Click"/>
                    </Grid>

                    <TextBlock Text="Options d'installation :" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Créer un raccourci sur le Bureau" IsChecked="True"/>
                    <CheckBox x:Name="ChkStartMenuShortcut" Content="Créer un raccourci dans le Menu Démarrer" IsChecked="True"/>
                    <CheckBox x:Name="ChkLaunchAfter" Content="Lancer IpScanConnect à la fin de l'installation" IsChecked="True"/>
                </StackPanel>

                <!-- ÉCRAN 2: EN COURS / TERMINÉ -->
                <StackPanel x:Name="PanelProgress" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" Text="Installation en cours..." FontSize="15" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <ProgressBar x:Name="ProgressBarInst" Height="14" IsIndeterminate="True" Background="#0A0C14" Foreground="#3B82F6" BorderBrush="#22283C" Margin="20,0,20,16"/>
                    <TextBlock x:Name="TxtDetail" Text="Copie des composants système..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRE DE BOUTONS EN BAS -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="© 2026 IpScanConnect • Licence MIT" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Annuler" Width="90" Height="34" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnInstall" Content="Installer maintenant 🚀" Width="150" Height="34"
                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnInstall_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
